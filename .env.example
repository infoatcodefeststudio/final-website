# ZeptoMail (Zoho) — server only; never expose ZEPTOMAIL_API_KEY to the browser.
# Create a Send Mail Token in ZeptoMail → Mail Agents → SMTP/API.

ZEPTOMAIL_API_KEY=your_send_mail_token_here

# Verified sender in ZeptoMail (must match your domain setup)
ZEPTOMAIL_FROM_EMAIL=noreply@codefeststudio.com
ZEPTOMAIL_FROM_NAME=Codefest Studio

# Inbox that receives contact & demo form submissions
LEAD_NOTIFY_EMAIL=info@codefeststudio.com

# Optional: use https://api.zeptomail.in/v1.1/email for India data center
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# Production Node server (npm run start)
# PORT=4173
